{
   "name": "preview-servant-frontend",
   "version": "0.9.0",
   "license": "MIT",
   "private": true,
   "scripts": {
      "serve": "vite",
      "build": "vite build",
      "test:unit": "vitest --coverage",
      "test:unit:ui": "vitest --coverage --ui",
      "test:e2e": "playwright test",
      "test:e2e:update-snapshots": "playwright test --update-snapshots",
      "test:e2e:update-snapshots:linux": "docker run --rm -v \"$(pwd)\":/app -w /app mcr.microsoft.com/playwright:v1.53.1-jammy bash -c \"npm ci && npm run test:e2e:update-snapshots\"",
      "test:e2e:ui": "playwright test --ui"
   },
   "dependencies": {
      "@asyncapi/react-component": "^2.5.0",
      "@fortawesome/fontawesome-free": "^5.15.4",
      "@fortawesome/fontawesome-svg-core": "^1.2.36",
      "@fortawesome/free-solid-svg-icons": "^5.15.4",
      "@fortawesome/vue-fontawesome": "^3.0.3",
      "@vue/compat": "^3.5.13",
      "bootstrap-material-design": "^4.1.3",
      "core-js": "^3.40.0",
      "eventsource": "^4.0.0",
      "http-link-header": "^1.1.3",
      "jquery": "^3.7.1",
      "moment": "^2.30.1",
      "popper.js": "^1.16.1",
      "swagger-ui": "^5.18.2",
      "vue": "^3.5.13",
      "vue-router": "^4.5.0",
      "vue-virtual-scroller": "^2.0.0-beta.8",
      "vuex": "^4.1.0"
   },
   "devDependencies": {
      "@playwright/test": "^1.53.1",
      "@rollup/plugin-inject": "^5.0.5",
      "@vitejs/plugin-vue": "^5.2.1",
      "@vitest/coverage-v8": "3.2.4",
      "@vitest/ui": "^3.2.4",
      "sass": "1.79.5",
      "vite": "^5.4.14",
      "vitest": "^3.2.4"
   }
}
